  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#5C677D", "fontStyle": "italic" }
    },
    {
      "scope": "constant.numeric",
      "settings": { "foreground": "#FFB86C" }
    },
    {
      "scope": "constant.language",
      "settings": { "foreground": "#F78CBE" }
    },
    {
      "scope": "constant.other.symbol",
      "settings": { "foreground": "#F78CBE" }
    },
    {
      "scope": "constant.other.color",
      "settings": { "foreground": "#FFB86C" }
    },
    {
      "scope": "constant.character.escape",
      "settings": { "foreground": "#FFB86C" }
    },
    {
      "scope": "constant.character.format.placeholder",
      "settings": { "foreground": "#FFB86C" }
    },
    {
      "scope": "entity.name.type",
      "settings": { "foreground": "#FFD580" }
    },
    {
      "scope": "entity.name.function",
      "settings": { "foreground": "#82AAFF" }
    },
    {
      "scope": "support.function",
      "settings": { "foreground": "#82AAFF" }
    },
    {
      "scope": "meta.function-call.generic",
      "settings": { "foreground": "#82AAFF" }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other.special-method",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#C4A1FF" }
    },
    {
      "scope": "keyword.operator",
      "settings": { "foreground": "#C4B5FD" }
    },
    {
      "scope": "string",
      "settings": { "foreground": "#A8DCA8" }
    },
    {
      "scope": "punctuation.definition.template-expression",
      "settings": { "foreground": "#C4B5FD" }
    },
    {
      "scope": "punctuation.section.embedded",
      "settings": { "foreground": "#C4B5FD" }
    },
    {
      "scope": "variable",
      "settings": { "foreground": "#E6EAF0" }
    },
    {
      "scope": "variable.language",
      "settings": { "foreground": "#C4A1FF", "fontStyle": "italic" }
    },
    {
      "scope": "variable.parameter",
      "settings": { "foreground": "#E0B8FF" }
    },
    {
      "scope": "variable.other.constant",
      "settings": { "foreground": "#F78CBE" }
    },
    {
      "scope": "variable.other.property",
      "settings": { "foreground": "#89DDFF" }
    },
    {
      "scope": ["support.class", "support.type"],
      "settings": { "foreground": "#FFD580" }
    },
    {
      "scope": "support.type.property-name",
      "settings": { "foreground": "#89DDFF" }
    },
    {
      "scope": ["support.constant", "support.variable"],
      "settings": { "foreground": "#F78CBE" }
    },
    {
      "scope": "support.constant.color-name",
      "settings": { "foreground": "#FFB86C" }
    },
    {
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": { "foreground": "#F0A6CA" }
    },
    {
      "scope": ["meta.decorator entity.name.function", "entity.name.function.decorator"],
      "settings": { "foreground": "#F0A6CA" }
    },
    {
      "scope": [
        "meta.annotation.identifier",
        "punctuation.definition.annotation",
        "meta.attribute"
      ],
      "settings": { "foreground": "#F0A6CA" }
    },
    {
      "scope": "entity.name.tag",
      "settings": { "foreground": "#F38BA8" }
    },
    {
      "scope": "punctuation.definition.tag",
      "settings": { "foreground": "#F38BA8" }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": { "foreground": "#A78BFA" }
    },
    {
      "scope": "support.constant.property-value",
      "settings": { "foreground": "#A8DCA8" }
    },
    {
      "scope": "keyword.other.unit",
      "settings": { "foreground": "#FFB86C" }
    },
    {
      "scope": ["entity.other.attribute-name.class", "entity.other.attribute-name.id"],
      "settings": { "foreground": "#FFD580" }
    },
    {
      "scope": [
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": { "foreground": "#C4A1FF" }
    },
    {
      "scope": "variable.other.custom-property",
      "settings": { "foreground": "#89DDFF" }
    },
    {
      "scope": ["variable.scss", "variable.other.scss"],
      "settings": { "foreground": "#F78CBE" }
    },
    {
      "scope": "entity.name.tag.yaml",
      "settings": { "foreground": "#89DDFF" }
    },
    {
      "scope": "meta.diff.header",
      "settings": { "foreground": "#82AAFF" }
    },
    {
      "scope": "markup.inserted",
      "settings": { "foreground": "#A8DCA8" }
    },
    {
      "scope": "markup.deleted",
      "settings": { "foreground": "#E06C75" }
    },
    {
      "scope": "markup.changed",
      "settings": { "foreground": "#E0AF68" }
    },
    {
      "scope": "markup.heading",
      "settings": { "foreground": "#C4A1FF", "fontStyle": "bold" }
    },
    {
      "scope": "markup.bold",
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": "markup.italic",
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": "markup.underline",
      "settings": { "fontStyle": "underline" }
    },
    {
      "scope": "markup.quote",
      "settings": { "foreground": "#9AA4B2", "fontStyle": "italic" }
    },
    {
      "scope": "markup.inline.raw",
      "settings": { "foreground": "#A8DCA8" }
    },
    {
      "scope": "punctuation.definition.markdown",
      "settings": { "foreground": "#5C677D" }
    },
    {
      "scope": ["punctuation.definition.list_item", "punctuation.definition.list.begin"],
      "settings": { "foreground": "#C4A1FF" }
    },
    {
      "scope": "string.other.link",
      "settings": { "foreground": "#82AAFF" }
    },
    {
      "scope": "markup.underline.link",
      "settings": { "foreground": "#89DDFF" }
    },
    {
      "scope": "invalid",
      "settings": { "foreground": "#E06C75", "background": "#E06C7522" }
    },
    {
      "scope": "invalid.deprecated",
      "settings": { "foreground": "#E0AF68", "fontStyle": "strikethrough" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#C4B5FD",
    "class": "#FFD580",
    "interface": "#FFD580",
    "struct": "#FFD580",
    "enum": "#FFD580",
    "enumMember": "#F78CBE",
    "type": "#FFD580",
    "typeParameter": "#E0B8FF",
    "function": "#82AAFF",
    "method": "#82AAFF",
    "macro": "#82AAFF",
    "decorator": "#F0A6CA",
    "parameter": "#E0B8FF",
    "variable": "#E6EAF0",
    "variable.readonly": "#F78CBE",
    "variable.static": "#F78CBE",
    "variable.default.library": "#F78CBE",
    "property": "#89DDFF",
    "property.static": "#F78CBE",
    "event": "#89DDFF",
    "regexp": "#A8DCA8"
  }
}
